# Copy to the ignored config.env, then edit. Explicit values here override the built-in defaults.

# Route. Default: the qualified native hyper-connection route for a symmetric pair of 22 GiB cards
# (fixed 24/24 layer split). Fallback for other GPU pairs: the automatic-split profile
#   PROFILE=q4km-int8kv-256k-dflash2-sm75-tcwide-c50-persistent
PROFILE=q4km-int8kv-256k-dflash2-sm75-tcwide-c50-trim24-fused-hcnative-persistent

# Your GPU pair (physical numbers, as nvidia-smi lists them). The template uses 2,3: change it, usually to 0,1.
GPU_DEVICES=2,3
HOST=127.0.0.1
PORT=3893
# SERVED_NAME=orcarouter-qwen3.8-flash-next-q4-k-m

# Model files. Defaults follow the README: shards and projector under MODEL_ROOT, pack and drafter under runtime/.
MODEL_ROOT=../models
# TARGET_MODEL=/path/to/Qwen3.8-Flash-Next-Uncensored-Q4_K_M-00001-of-00003.gguf
# PACK_DIR=runtime/packs/orca-q4_k_m
# DRAFT_PACK=runtime/dflash2/qwen3.8-flash-next-dflash2.strata1.q4_0-selq4.pack
PYTHON_BIN=.venv/bin/python
# CUDA_TOOLKIT=/usr/local/cuda-13.4

# CPU placement: automatic only on a verified single-socket EPYC/NPS4 topology; off disables it.
CPU_NUMA_POLICY=auto

# Restart-surviving prefix snapshots (persistent profiles); generated data outside the repository.
# PERSISTENT_CACHE_DIR=../strata-kv-caches
# PERSISTENT_CACHE_GIB=64
# PERSISTENT_CACHE_MIN_TOKENS=1024

# Image input (build the reader with bash build-vision.sh); off, cpu or gpu.
VISION_MODE=cpu
# MMPROJ=/path/to/mmproj-Qwen3.8-Flash-Next-Uncensored-F16.gguf   # default: beside the first shard
# VISION_MAX_TOKENS=auto         # per image: auto = 1024 on cpu, 4096 on gpu; or a number
# VISION_THREADS=16
# VISION_CUDA_DEVICE=2           # gpu mode only: physical GPU number
# VISION_VRAM_RESERVE_MIB=700    # gpu mode only

# Development (docs/DEVELOPMENT.md): an experiment's own source, manifest, binary and runtime/cache paths.
# UPSTREAM_MANIFEST=/path/to/experiment/upstream.json
# STRATA_SOURCE_DIR=/path/to/strata-worktree
# SERVER_BIN=build/sm75/strata
# ENGINE_LIBRARY_PATH=build/sm75
# RUNTIME_DIR=runtime

diff --git a/include/strata/core/host_profile.hpp b/include/strata/core/host_profile.hpp
new file mode 100644
index 00000000..0bc1f3fd
--- /dev/null
+++ b/include/strata/core/host_profile.hpp
@@ -0,0 +1,51 @@
+#pragma once
+
+#include <cstdint>
+#include <cstdlib>
+
+// Host-only tracing: unlike STRATA_VERIFY_PROFILE, this does not insert GPU
+// stamp kernels or change the captured fusion/stream dispatch.  Optional NVTX3
+// headers come from the CUDA toolkit; other builds keep no-op ranges.
+#if !defined(STRATA_USE_HIP) && __has_include(<nvtx3/nvToolsExt.h>)
+#include <nvtx3/nvToolsExt.h>
+#define STRATA_HOST_NVTX 1
+#endif
+
+namespace strata::core::host_profile {
+inline bool enabled() {
+    static const bool on = [] {
+        const char* value = std::getenv("STRATA_VERIFY_HOST_PROFILE");
+        return value && value[0] == '1';
+    }();
+    return on;
+}
+class Range {
+public:
+    Range(const char* name, uint64_t payload) {
+#if defined(STRATA_HOST_NVTX)
+        if (!enabled()) return;
+        nvtxEventAttributes_t event{};
+        event.version = NVTX_VERSION;
+        event.size = NVTX_EVENT_ATTRIB_STRUCT_SIZE;
+        event.messageType = NVTX_MESSAGE_TYPE_ASCII;
+        event.message.ascii = name;
+        event.payloadType = NVTX_PAYLOAD_TYPE_UNSIGNED_INT64;
+        event.payload.ullValue = payload;
+        nvtxRangePushEx(&event);
+        active_ = true;
+#else
+        (void) name; (void) payload;
+#endif
+    }
+    ~Range() { finish(); }
+    Range(const Range&) = delete;
+    Range& operator=(const Range&) = delete;
+    void finish() {
+#if defined(STRATA_HOST_NVTX)
+        if (active_) { nvtxRangePop(); active_ = false; }
+#endif
+    }
+private:
+    bool active_ = false;
+};
+} // namespace strata::core::host_profile

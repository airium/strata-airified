+__device__ __forceinline__ uint16_t bf16_rne(float v) { return __bfloat16_as_ushort(__float2bfloat16_rn(v)); }
+__global__ void hcnq_dequant_kernel(const uint8_t* __restrict__ src, int fmt, int64_t rows, int64_t cols, uint16_t* __restrict__ dst) {
+    const int64_t i = (int64_t) blockIdx.x * blockDim.x + threadIdx.x;
+    if (i >= rows * cols) return;
+    const int64_t r = i / cols, k = i - r * cols;
+    float y;
+    if (fmt == 2) {   // Q5_0 lane-major row (320 B): element k = lane k % 32 of block k / 32
+        const uint8_t* row = src + r * kHcNqQ5Row;
+        const int b = (int) (k >> 5), l = (int) (k & 31);
+        const uint32_t w = *reinterpret_cast<const uint32_t*>(row + 8 * l + (b < 6 ? 0 : 4));
+        const int q = (int) ((w >> (5 * (b < 6 ? b : b - 6))) & 31u) - 16;
+        const float d = *reinterpret_cast<const float*>(row + 256 + 4 * b);
+        y = __fmul_rn(d, (float) q);                                          // gguf-py: d * (q - 16)
+    } else {
+        const int64_t sb = k >> 8;
+        const int e = (int) (k & 255);
+        if (fmt == 0) {   // Q4_K, 144-byte superblocks as stored
+            const uint8_t* blk = src + (r * (cols >> 8) + sb) * 144;
+            const float d = __half2float(*reinterpret_cast<const __half*>(blk)), dmin = __half2float(*reinterpret_cast<const __half*>(blk + 2));
+            const uint8_t* s = blk + 4;
+            const int j = e >> 5, l = e & 31;
+            int sc, m;
+            if (j < 4) { sc = s[j] & 63; m = s[j + 4] & 63; }
+            else { sc = (s[j + 4] & 0xF) | ((s[j - 4] >> 6) << 4); m = (s[j + 4] >> 4) | ((s[j] >> 6) << 4); }
+            const int q = (blk[16 + 32 * (j >> 1) + l] >> (4 * (j & 1))) & 0xF;
+            y = __fsub_rn(__fmul_rn(__fmul_rn(d, (float) sc), (float) q), __fmul_rn(dmin, (float) m));   // gguf-py: (d*sc)*q - dmin*m
+        } else {          // Q6_K, 224-byte superblocks (f32 d at 208)
+            const uint8_t* blk = src + (r * (cols >> 8) + sb) * kHcNqQ6kBlock;
+            const int n = e >> 7, rem = e & 127, jl = rem >> 5, l = rem & 31;
+            const int ql = (blk[n * 64 + 32 * (jl & 1) + l] >> (4 * (jl >> 1))) & 0xF;
+            const int qh = (blk[128 + n * 32 + l] >> (2 * jl)) & 3;
+            const float d = *reinterpret_cast<const float*>(blk + 208);
+            const int8_t sc = (int8_t) blk[192 + (e >> 4)];
+            y = __fmul_rn(__fmul_rn(d, (float) sc), (float) ((ql | (qh << 4)) - 32));   // gguf-py: (d*sc) * (q - 32)
+        }
+    }
+    dst[i] = bf16_rne(y);
+}

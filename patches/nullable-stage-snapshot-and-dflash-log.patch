+uint64_t Dflash2Drafter::session_state_limit(uint64_t max_tokens) const {
+    if (max_tokens > (uint64_t) INT32_MAX) return UINT64_MAX;
+    const uint64_t chunks = (max_tokens + kLogChunk - 1) / kLogChunk + 1;
+    return 80 + max_tokens * 4 + chunks * (8 + (uint64_t) kLogChunk * (2560 + 80 * 4 + 1));
+}
+
+bool Dflash2Drafter::save_session_state(std::vector<uint8_t>& out, std::string& err) {
+    if (!log_on_ || N_ != 2560) { err = "dflash2: session persistence needs the ring log"; return false; }
+    if (!context_wait(err)) return false;
+    const OnDevice on_device(device_);
+    if (cudaStreamSynchronize(cs_) != cudaSuccess) { err = "dflash2: sync before session save"; return false; }
+    log_flush();
+    out.clear();
+    auto raw = [&](const void* p, size_t n) { const auto* b = (const uint8_t*) p; if (n) out.insert(out.end(), b, b + n); };
+    auto u64 = [&](uint64_t v) { raw(&v, 8); };
+    raw("DF2LOG01", 8);
+    for (uint64_t v : {uint64_t(N_), uint64_t(L_), uint64_t(NKV_), uint64_t(HD_), uint64_t(window_),
+                       uint64_t(cur_.hist.size()), uint64_t(cur_.chunks.size())}) u64(v);
+    raw(cur_.hist.data(), cur_.hist.size() * 4);
+    for (const auto& c : cur_.chunks) {
+        u64(c ? 1 : 0);
+        if (c) { raw(c->q.data(), c->q.size()); raw(c->d.data(), c->d.size() * 4); raw(c->ok.data(), c->ok.size()); }
+    }
+    return true;
+}
+
+bool Dflash2Drafter::prepare_session_restore(const std::vector<uint8_t>& bytes, uint64_t max_tokens, std::string& err) {
+    session_pending_.reset();
+    auto fail = [&](const char* why) { err = std::string("dflash2 session: ") + why; return false; };
+    if (!log_on_ || N_ != 2560) return fail("ring log unavailable");
+    if (bytes.size() < 64 || bytes.size() > session_state_limit(max_tokens) || std::memcmp(bytes.data(), "DF2LOG01", 8))
+        return fail("invalid header or extent");
+    size_t at = 8;
+    auto raw = [&](void* p, size_t n) {
+        if (n > bytes.size() - at) return false;
+        if (n) std::memcpy(p, bytes.data() + at, n);
+        at += n; return true;
+    };
+    auto u64 = [&](uint64_t& v) { return raw(&v, 8); };
+    uint64_t n = 0, layers = 0, heads = 0, dim = 0, window = 0, history = 0, chunks = 0;
+    if (!u64(n) || !u64(layers) || !u64(heads) || !u64(dim) || !u64(window) || !u64(history) || !u64(chunks) ||
+        n != (uint64_t) N_ || layers != (uint64_t) L_ || heads != (uint64_t) NKV_ || dim != (uint64_t) HD_ || window != (uint64_t) window_)
+        return fail("another drafter geometry/window");
+    if (history > max_tokens || chunks > (max_tokens + kLogChunk - 1) / kLogChunk + 1 || history > (bytes.size() - at) / 4)
+        return fail("counts exceed runtime bounds");
+    auto parsed = std::make_unique<Lineage>();
+    parsed->hist.resize((size_t) history);
+    if (!raw(parsed->hist.data(), (size_t) history * 4)) return fail("truncated token history");
+    for (int32_t token : parsed->hist) if (token < 0) return fail("invalid history token");
+    parsed->chunks.resize((size_t) chunks);
+    constexpr size_t qbytes = kLogChunk * 2560, dcount = kLogChunk * 80;
+    for (size_t i = 0; i < (size_t) chunks; ++i) {
+        uint64_t present = 0;
+        if (!u64(present) || present > 1) return fail("invalid chunk presence");
+        if (!present) continue;
+        if (qbytes + dcount * 4 + kLogChunk > bytes.size() - at) return fail("truncated log chunk");
+        auto c = std::make_shared<LogChunk>(); c->q.resize(qbytes); c->d.resize(dcount); c->ok.resize(kLogChunk);
+        if (!raw(c->q.data(), qbytes) || !raw(c->d.data(), dcount * 4) || !raw(c->ok.data(), kLogChunk)) return fail("truncated log");
+        for (uint8_t valid : c->ok) if (valid > 1) return fail("invalid row mask");
+        for (float scale : c->d) if (!std::isfinite(scale) || scale < 0) return fail("invalid quantization scale");
+        parsed->chunks[i] = std::move(c);
+    }
+    if (at != bytes.size()) return fail("unparsed log bytes");
+    session_pending_ = std::move(parsed);
+    return true;
+}
+
+void Dflash2Drafter::commit_session_restore() {
+    auto parsed = std::move(session_pending_);
+    reset();
+    if (parsed) { cur_ = std::move(*parsed); have_ctx_ = (int64_t) cur_.hist.size(); }
+    launched_ = false;
+    dpend_lo_ = dpend_hi_ = 0;
+}

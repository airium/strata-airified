diff --git a/cmake/ggml_tq_overlay_test.cmake b/cmake/ggml_tq_overlay_test.cmake
index 26447c83..3928bb81 100644
--- a/cmake/ggml_tq_overlay_test.cmake
+++ b/cmake/ggml_tq_overlay_test.cmake
@@ -80,4 +80,28 @@ endif()
 if(_ok LESS 0)
   message(FATAL_ERROR "the generated DP4A callback does not match this ggml-cuda's signatures")
 endif()
+# A second configure must preserve both generated bytes and mtimes. Otherwise
+# Ninja recompiles every CUDA MMQ instance even when no source changed.
+file(GLOB_RECURSE _outputs "${OUT}/*")
+set(_before "")
+foreach(_f IN LISTS _outputs)
+  if(NOT IS_DIRECTORY "${_f}")
+    file(SHA256 "${_f}" _hash)
+    file(TIMESTAMP "${_f}" _time "%s")
+    string(APPEND _before "${_f}:${_hash}:${_time}\n")
+  endif()
+endforeach()
+execute_process(COMMAND "${CMAKE_COMMAND}" -E sleep 1.1 COMMAND_ERROR_IS_FATAL ANY)
+strata_ggml_tq_overlay("${LLAMA}" "${OUT}")
+set(_after "")
+foreach(_f IN LISTS _outputs)
+  if(NOT IS_DIRECTORY "${_f}")
+    file(SHA256 "${_f}" _hash)
+    file(TIMESTAMP "${_f}" _time "%s")
+    string(APPEND _after "${_f}:${_hash}:${_time}\n")
+  endif()
+endforeach()
+if(NOT _before STREQUAL _after)
+  message(FATAL_ERROR "no-op overlay regeneration changed content or timestamps")
+endif()
 message(STATUS "ggml_tq_overlay_test: ok")

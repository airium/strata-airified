 #
 #   strata_ggml_tq_overlay(<llama.cpp dir> <out dir>)  ->  STRATA_TQ_OVERLAY_OK (parent scope)
 
+# Preserve timestamps on no-op reconfiguration: all MMQ instances include these
+# generated headers, so rewriting identical bytes triggers a full CUDA rebuild.
+function(_strata_tq_write_if_different PATH CONTENT)
+  if(EXISTS "${PATH}")
+    file(READ "${PATH}" _old)
+    if(_old STREQUAL CONTENT)
+      return()
+    endif()
+  endif()
+  file(WRITE "${PATH}" "${CONTENT}")
+endfunction()
+

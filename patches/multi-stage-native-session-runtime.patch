--- a/src/core/conversation_state.cpp
+++ b/src/core/conversation_state.cpp
@@ -704,6 +704,30 @@ bool conversation_snapshot_validate(const SavedConversation& image, const Sessio
     return !draft || conversation_kv_validate(image.kv.back(), *draft, g, upto, false, error);
 }
 
+bool conversation_snapshot_verify(const SavedConversation& image, const SessionState& ss,
+                                  const ModelGeometry& g, const QsaState* draft, uint64_t& fingerprint,
+                                  std::string& error) {
+    ConversationCheckpoint observed;
+    observed.ids = image.live.ids; observed.imgs = image.live.imgs;
+    if (!conversation_checkpoint_save(observed, ss, g, error)) return false;
+    conversation_checkpoint_join(observed.gdn.data());
+    if (observed.gdn != image.live.gdn || observed.ple != image.live.ple || observed.tails != image.live.tails ||
+        observed.dead != image.live.dead || observed.block_pos != image.live.block_pos)
+        return fail(error, "restored recurrent/indexer bytes differ");
+    SessionHasher hash;
+    for (const auto* bytes : {&observed.gdn, &observed.ple, &observed.tails, &observed.dead, &observed.block_pos})
+        hash.update(bytes->data(), bytes->size());
+    for (size_t i = 0; i < owned_qsa(ss) + (draft ? 1 : 0); ++i) {
+        uint64_t kv_hash = 0;
+        const bool main = i < owned_qsa(ss);
+        if (!conversation_kv_verify(image.kv[i], main ? owned(ss, i) : *draft, g,
+                                    (int64_t) image.live.ids.size(), main, kv_hash, error)) return false;
+        hash.update(&kv_hash, sizeof kv_hash);
+    }
+    fingerprint = hash.digest();
+    return true;
+}

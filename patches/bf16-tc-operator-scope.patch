+// Optional operator isolation: keep routing/indexer and other projections on
+// their original BF16 arithmetic while evaluating only hyperconnection GEMMs.
+int bf16_path_for_shape(int64_t N, int64_t K) {
+    const int path = bf16_path();
+    if (path != 1) return path;
+    static const int scope = [] {
+        const char* e = std::getenv("STRATA_BF16_TC_SCOPE");
+        if (e == nullptr || std::strcmp(e, "all") == 0) return 0;
+        if (std::strcmp(e, "hc") == 0) return 1;
+        if (std::strcmp(e, "up") == 0) return 2;
+        std::fprintf(stderr, "STRATA_BF16_TC_SCOPE: expected all, hc or up\n");
+        std::exit(1);
+    }();
+    if (scope == 0) return path;
+    const auto& g = strata::core::kCompiledGeometry;
+    const bool up = K == g.hc_lr && N == g.hc_dim();
+    const bool read = K == g.hc_dim() && (N == g.hc_lr || N == g.hc);
+    return (up || (scope == 1 && read)) ? path : 0;
+}

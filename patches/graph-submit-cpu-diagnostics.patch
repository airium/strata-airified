 namespace strata::core {
 
+namespace host_launch_detail {
+// CPU-only diagnostic, independent of Nsight interception and the watchdog
+// probe's sleeps/join.  The timer brackets only cudaGraphLaunch.  Report once
+// per128 submissions, not once per layer/window.  Off: no clock reads or locks.
+inline cudaError_t submit(cudaGraphExec_t graph, cudaStream_t stream, int device) {
+    static const bool timed = [] { const char* e = std::getenv("STRATA_GRAPH_SUBMIT_TIMING"); return e && e[0] == '1'; }();
+    if (!timed) return cudaGraphLaunch(graph, stream);
+    const auto start = std::chrono::steady_clock::now();
+    const cudaError_t error = cudaGraphLaunch(graph, stream);
+    const double us = std::chrono::duration<double, std::micro>(std::chrono::steady_clock::now() - start).count();
+    struct Stats { unsigned long long n = 0; double sum = 0, maximum = 0; };
+    static Stats stats[64];
+    static std::mutex mu;
+    std::lock_guard<std::mutex> lock(mu);
+    Stats& s = stats[device >= 0 && device < 64 ? device : 0];
+    ++s.n; s.sum += us; if (us > s.maximum) s.maximum = us;
+    if (s.n == 128) {
+        std::fprintf(stderr, "strata graph submit: device %d submissions %llu mean_us %.3f max_us %.3f (CPU timer, launch call only)\n",
+                     device, s.n, s.sum / (double) s.n, s.maximum);
+        s = {};
+    }
+    return error;
+}
+} // namespace host_launch_detail
+
 // One submission thread per verifier/device, not per window.  The engine's host

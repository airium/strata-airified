+"""Bounded automatic prefix snapshots using Strata's native SAVE/RESTORE protocol.
+
+Only safe request boundaries do storage I/O. Native validation owns model/state
+compatibility; token metadata is a selection hint, never permission for a KV hit.
+"""
+from array import array
+import contextlib
+import hashlib
+import json
+import os
+from pathlib import Path
+import re
+import tempfile
+import time
+import uuid
+try:
+    import fcntl
+except ImportError:
+    fcntl=None
+
+_SCHEMA = 1
+_LEAF = re.compile(r'[0-9a-f]{64}-[0-9a-f]{32}\.session\Z')
+_KEY = re.compile(r'[0-9a-f]{64}\Z')
+
+
+def _sha(path):
+    h = hashlib.sha256()
+    with Path(path).open('rb') as stream:
+        for block in iter(lambda: stream.read(1 << 20), b''): h.update(block)
+    return h.hexdigest()
+
+
+def prepare_environment(exe, args, cwd, env):
+    """Compute a stable per-build/config namespace, independent of PIDs/log paths."""
+    if not env or not env.get('STRATA_PERSISTENT_CACHE_DIR'): return env, None
+    if fcntl is None:raise ValueError('persistent prefix cache is currently qualified on Linux only')
+    actual = dict(env)
+    root = Path(actual['STRATA_PERSISTENT_CACHE_DIR']).expanduser().resolve()
+    budget = int(actual.get('STRATA_PERSISTENT_CACHE_GIB', '64')) * (1 << 30)
+    minimum = int(actual.get('STRATA_PERSISTENT_CACHE_MIN_TOKENS', '1024'))
+    if budget <= 0: return actual, None
+    if minimum < 1: raise ValueError('persistent cache minimum must be positive')
+    if '--prompt-cache' not in args or int(args[args.index('--prompt-cache') + 1]) <= 0:
+        raise ValueError('persistent prefix cache needs --prompt-cache > 0')
+    if any(flag in args and int(args[args.index(flag) + 1]) > 0 for flag in ['--batch','--slots','--parallel']):
+        raise ValueError('persistent prefix cache currently requires a single request')
+    binary = Path(exe).resolve()
+    signature = {'schema':_SCHEMA, 'binary':_sha(binary), 'args':list(args), 'cwd':str(Path(cwd).resolve()),
+                 'environment':{k:v for k,v in actual.items() if k.startswith('STRATA_') and not k.startswith('STRATA_PERSISTENT_')
+                                and k not in ['STRATA_SESSION_BUILD_KEY','STRATA_SESSION_VERIFY','STRATA_MANIFEST']}}
+    library = binary.parent / 'libstrata_kq.so'
+    if library.exists(): signature['kquant_library'] = _sha(library)
+    inputs = {}
+    for i, flag in enumerate(args[:-1]):
+        if flag in ['--native','--pack','--ple-gguf','--draft-model','--expert-profile','--mtp-draft-vocab']:
+            path = Path(args[i+1]);path = path if path.is_absolute() else Path(cwd)/path
+            candidates = [path] if path.is_file() else [path/'dense.bin',path/'index.txt']
+            if flag == '--native' and '-00001-of-' in path.name:
+                candidates = sorted(path.parent.glob(path.name.replace('-00001-of-', '-*-of-')))
+            for file in candidates:
+                if file.exists():
+                    st=file.stat();inputs[str(file.resolve())]=[st.st_size,st.st_mtime_ns]
+    signature['inputs'] = inputs
+    key=hashlib.sha256(json.dumps(signature,sort_keys=True,separators=(',',':')).encode()).hexdigest()
+    actual['STRATA_SESSION_BUILD_KEY']=key
+    max_context=int(args[args.index('--max-context')+1]) if '--max-context' in args else 4096
+    return actual, PersistentPrefixCache(root,key,budget,minimum,max_context)
+
+
+def _atomic_json(path, value):
+    fd, temporary = tempfile.mkstemp(prefix='.'+path.name+'.', suffix='.tmp',dir=path.parent)
+    try:
+        with os.fdopen(fd,'w',encoding='utf-8') as stream:
+            json.dump(value,stream,separators=(',',':'));stream.flush();os.fsync(stream.fileno())
+        os.replace(temporary,path)
+        directory=os.open(path.parent,os.O_RDONLY|os.O_DIRECTORY)
+        try:os.fsync(directory)
+        finally:os.close(directory)
+    finally:
+        try:os.unlink(temporary)
+        except FileNotFoundError:pass
+
+
+def _lcp(a,b):
+    for i,(x,y) in enumerate(zip(a,b)):
+        if x!=y:return i
+    return min(len(a),len(b))
+
+
+def _token_key(ids):return hashlib.sha256(array('i',ids).tobytes()).hexdigest()
+
+
+class PersistentPrefixCache:
+    def __init__(self,root,namespace,budget,minimum,max_context):
+        self.root=Path(root)/'prefixes';self.root.mkdir(parents=True,exist_ok=True,mode=0o700)
+        self.directory=self.root/namespace;self.directory.mkdir(exist_ok=True,mode=0o700)
+        if self.root.is_symlink() or self.directory.is_symlink():raise ValueError('persistent prefix directories must not be symbolic links')
+        self.base_namespace=namespace
+        self.namespace=namespace;self.budget=budget;self.minimum=minimum;self.max_context=max_context
+        self.live=[];self.stats={'lookups':0,'restores':0,'prefix_hits':0,'saved':0,'errors':0,'evictions':0}
+        self.current={}
+        marker=self.directory/'owner.json'
+        if not marker.exists():_atomic_json(marker,{'schema':_SCHEMA,'owner':'strata-airified-persistent-prefix'})
+
+    def bind_layout(self,layout):
+        key=hashlib.sha256((self.base_namespace+':'+str(layout)).encode()).hexdigest()
+        self.namespace=key;self.directory=self.root/key
+        if self.directory.is_symlink():raise ValueError('persistent namespace must not be a symbolic link')
+        self.directory.mkdir(exist_ok=True,mode=0o700)
+        marker=self.directory/'owner.json'
+        if not marker.exists():_atomic_json(marker,{'schema':_SCHEMA,'owner':'strata-airified-persistent-prefix'})
+
+    @contextlib.contextmanager
+    def locked(self):
+        with (self.root/'.lock').open('a+b') as stream:
+            os.chmod(stream.name,0o600);fcntl.flock(stream,fcntl.LOCK_EX)
+            try:yield
+            finally:fcntl.flock(stream,fcntl.LOCK_UN)
+
+    def _clean_pending(self):
+        for directory in self.root.iterdir():
+            if not directory.is_dir() or directory.is_symlink() or not _KEY.fullmatch(directory.name):continue
+            try:
+                owner=json.loads((directory/'owner.json').read_text())
+                if not isinstance(owner,dict) or owner.get('owner')!='strata-airified-persistent-prefix':continue
+            except (OSError,ValueError):continue
+            for file in directory.glob('.*.tmp'):
+                if file.is_symlink():continue
+                if re.fullmatch(r'\.[0-9a-f]{64}\.[0-9a-f]{16}\.tmp',file.name) or re.fullmatch(r'\.[0-9a-f]{64}\.json\.[A-Za-z0-9_-]+\.tmp',file.name):
+                    try:file.unlink()
+                    except FileNotFoundError:pass
+
+    def _load(self,path):
+        try:
+            if path.is_symlink() or path.stat().st_size>self.max_context*12+65536:return None
+            row=json.loads(path.read_text())
+            if not isinstance(row,dict):return None
+            if row.get('schema')!=_SCHEMA or row.get('namespace')!=self.namespace or not _LEAF.fullmatch(row.get('file','')):return None
+            ids=row.get('ids')
+            if not isinstance(ids,list) or len(ids)>self.max_context or not all(isinstance(x,int) and not isinstance(x,bool) and 0<=x<2**31 for x in ids):return None
+            file=self.directory/row['file']
+            if not file.is_file() or file.is_symlink() or file.stat().st_size!=row.get('bytes'):return None
+            return row
+        except (OSError,ValueError,TypeError):return None
+
+    def eligible(self,sampling,embeddings=None):
+        return not embeddings and sampling.get('cache_prompt') is not False
+
+    def before(self,engine,ids,sampling,embeddings=None):
+        self.current={'restored':False,'candidate_tokens':0,'restore_ms':0,'saved':False,'save_ms':0}
+        if not self.eligible(sampling,embeddings) or len(ids)<self.minimum:return
+        self.stats['lookups']+=1
+        try:
+            with self.locked():
+                self._clean_pending()
+                best=None;common=0
+                exact=self.directory/(_token_key(ids)+'.json')
+                paths=[exact]+[p for p in self.directory.glob('*.json') if p!=exact and p.name!='owner.json']
+                for path in paths:
+                    row=self._load(path)
+                    if row is None:continue
+                    n=_lcp(row['ids'],ids)
+                    if n>common:best=(path,row);common=n
+                    if common==len(ids):break
+                if best is None or common<self.minimum or _lcp(self.live,ids)>=common:return
+                path,row=best
+                t=time.monotonic()
+                try:engine.session_file('restore',str(self.directory/row['file']))
+                except Exception as error:
+                    if getattr(error,'kind',None) not in ('invalid','memory','storage','io'):raise
+                    self.stats['errors']+=1
+                    if getattr(error,'kind',None)=='invalid':path.rename(path.with_suffix('.invalid'))
+                    print('[strata] persistent prefix restore skipped: '+str(error),flush=True)
+                    return
+                self.live=list(row['ids']);self.stats['restores']+=1
+                self.current.update(restored=True,candidate_tokens=common,restore_ms=(time.monotonic()-t)*1000)
+                row['accessed']=time.time();_atomic_json(path,row);os.utime(self.directory/row['file'],None)
+                print(f'[strata] persistent prefix: restored candidate {common} tokens; native GEN decides actual reuse',flush=True)
+        except OSError as error:
+            self.stats['errors']+=1;print('[strata] persistent prefix lookup skipped: '+str(error),flush=True)
+
+    def after(self,engine,ids,output,sampling,cancel,embeddings=None):
+        actual=int(engine.last.get('reused',0));self.current['reused_tokens']=actual
+        if self.current.get('restored') and actual>0:self.stats['prefix_hits']+=1
+        if not self.eligible(sampling,embeddings) or sampling.get('strata_checkpoint') is False or cancel.is_set():
+            self.live=[];engine.last['persistent_cache']=dict(self.current);return
+        known=list(ids)+list(output);self.live=list(ids)
+        if len(ids)<self.minimum:return
+        key=_token_key(ids);path=self.directory/(key+'.json')
+        leaf=key+'-'+uuid.uuid4().hex+'.session';file=self.directory/leaf
+        try:
+            with self.locked():
+                self._clean_pending()
+                old=self._load(path)
+                if old and len(known)-1 <= old['tokens'] <= len(known) and old['ids']==known[:old['tokens']]:
+                    old['accessed']=time.time();_atomic_json(path,old);os.utime(self.directory/old['file'],None);self.live=list(old['ids']);return
+                t=time.monotonic()
+                try:saved=engine.session_file('save',str(file))
+                except Exception as error:
+                    if getattr(error,'kind',None) not in ('invalid','memory','storage','io') and engine.alive():raise
+                    if file.exists():file.unlink()
+                    self.stats['errors']+=1;print('[strata] persistent prefix save skipped: '+str(error),flush=True);return
+                count=int(saved['tokens'])
+                # Never invent token identity when native bookkeeping contains an unobserved token.
+                known=known[:min(len(known),count)]
+                if len(known)<self.minimum or saved['bytes']>self.budget:
+                    file.unlink();return
+                row={'schema':_SCHEMA,'namespace':self.namespace,'file':leaf,'ids':known,'tokens':count,
+                     'bytes':int(saved['bytes']),'created':time.time(),'accessed':time.time()}
+                _atomic_json(path,row)
+                self.live=list(known);self.stats['saved']+=1
+                self.current.update(saved=True,save_ms=(time.monotonic()-t)*1000,bytes=row['bytes'])
+                if old and old['file']!=leaf:
+                    try:(self.directory/old['file']).unlink()
+                    except FileNotFoundError:pass
+                self._evict(file)
+        except OSError as error:
+            self.stats['errors']+=1;print('[strata] persistent prefix commit skipped: '+str(error),flush=True)
+        finally:
+            engine.last['persistent_cache']=dict(self.current)
+
+    def _evict(self,keep):
+        files=[];total=0
+        for namespace in self.root.iterdir():
+            if not namespace.is_dir() or namespace.is_symlink() or not _KEY.fullmatch(namespace.name):continue
+            try:
+                marker=json.loads((namespace/'owner.json').read_text())
+                if not isinstance(marker,dict):continue
+                if marker.get('owner')!='strata-airified-persistent-prefix':continue
+            except (OSError,ValueError):continue
+            for file in namespace.glob('*.session'):
+                if file.is_symlink() or not _LEAF.fullmatch(file.name):continue
+                try:st=file.stat()
+                except FileNotFoundError:continue
+                total+=st.st_size;files.append((st.st_mtime,file,st.st_size))
+        for _,file,size in sorted(files):
+            if total<=self.budget:break
+            if file==keep:continue
+            try:file.unlink()
+            except FileNotFoundError:continue
+            key=file.name[:64];meta=file.parent/(key+'.json')
+            try:
+                row=json.loads(meta.read_text())
+                if row.get('file')==file.name:meta.unlink()
+            except (OSError,ValueError):pass
+            total-=size;self.stats['evictions']+=1

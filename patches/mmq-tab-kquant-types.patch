-// the pointer-table MMQ per type: the native packs' nine types (CMake's _strata_mmq_tab_types, all of them checked
-// bit for bit by prefill_mmq_tab_test).  false: no instance - the optional Q5_0 and K-quant experts keep the gather
+// the pointer-table MMQ per type: the types CMake's STRATA_MMQ_TAB_TYPES built an instance for (STRATA_MMQ_TAB_<TYPE>;
+// by default the native packs' nine), each checked bit for bit by prefill_mmq_tab_test.  false: no instance - the
+// expert keeps the gather
 bool run_tab(ggml_backend_cuda_context* ctx, const mmq_args* a, const mmq_x_tab* tab, cudaStream_t s) {
     const ggml_type t = a ? a->type_x : GGML_TYPE_COUNT;
 #define STRATA_TAB_CASE(T) case T: return ctx == nullptr || mul_mat_q_tab_case<T>(*ctx, *a, *tab, s)
     switch (t) {
+#if defined(STRATA_MMQ_TAB_Q2_0)
         STRATA_TAB_CASE(GGML_TYPE_Q2_0);
+#endif
+#if defined(STRATA_MMQ_TAB_IQ2_XXS)
         STRATA_TAB_CASE(GGML_TYPE_IQ2_XXS);
+#endif
+#if defined(STRATA_MMQ_TAB_IQ2_XS)
         STRATA_TAB_CASE(GGML_TYPE_IQ2_XS);
+#endif
+#if defined(STRATA_MMQ_TAB_IQ2_S)
         STRATA_TAB_CASE(GGML_TYPE_IQ2_S);
+#endif
+#if defined(STRATA_MMQ_TAB_IQ3_XXS)
         STRATA_TAB_CASE(GGML_TYPE_IQ3_XXS);
+#endif
+#if defined(STRATA_MMQ_TAB_IQ3_S)
         STRATA_TAB_CASE(GGML_TYPE_IQ3_S);
+#endif
+#if defined(STRATA_MMQ_TAB_IQ4_NL)
         STRATA_TAB_CASE(GGML_TYPE_IQ4_NL);
+#endif
+#if defined(STRATA_MMQ_TAB_IQ4_XS)
         STRATA_TAB_CASE(GGML_TYPE_IQ4_XS);
+#endif
+#if defined(STRATA_MMQ_TAB_Q8_0)
         STRATA_TAB_CASE(GGML_TYPE_Q8_0);
+#endif
+#if defined(STRATA_MMQ_TAB_Q5_0)
+        STRATA_TAB_CASE(GGML_TYPE_Q5_0);
+#endif
+#if defined(STRATA_MMQ_TAB_Q5_1)
+        STRATA_TAB_CASE(GGML_TYPE_Q5_1);
+#endif
+#if defined(STRATA_MMQ_TAB_Q4_K)
+        STRATA_TAB_CASE(GGML_TYPE_Q4_K);
+#endif
+#if defined(STRATA_MMQ_TAB_Q5_K)
+        STRATA_TAB_CASE(GGML_TYPE_Q5_K);
+#endif
+#if defined(STRATA_MMQ_TAB_Q6_K)
+        STRATA_TAB_CASE(GGML_TYPE_Q6_K);
+#endif
         default: return false;
     }
 #undef STRATA_TAB_CASE

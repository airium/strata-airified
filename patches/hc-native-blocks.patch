+// ================================ STRATA_HC_NATIVE: the checkpoint's own blocks ================================
+// The decode verify read with the GGUF's hyper-connection projections as stored (Q4_K / Q6_K down rows, Q5_0 up rows),
+// FP32 activations and the GGUF's dequantized values exactly (y = d*sc*q - dmin*m, d*(q - 16), d*sc*(q - 32)) - not the
+// pack's BF16 rounding of them.  3.2x fewer weight bytes than the BF16 rows.  The norm is gr_norm_split_kernel's; the
+// down projection is split over its 40 superblock columns (a warp = 8 rows x 1 superblock, the activations in
+// registers), the 40 partial sums are added in a fixed order by a small kernel (deterministic), and the up projection
+// reads each row's 10 Q5_0 blocks lane-major (lane l = element l of every block: the block scales are warp-uniform).
+// Another summation order than the BF16 read: not bitwise any other read.
+namespace hcnq {
+constexpr int NS = D / 256;                 // 40 superblocks a down row
+constexpr int ROWS = LR + HC;               // 320 down rows + the 4 inject rows
+constexpr int GROUPS = (ROWS + 7) / 8;      // 41 groups of 8 rows; group 40 = the inject rows
+constexpr int PART_T = kFusedGrMaxT;
+__device__ __forceinline__ float h2f(uint32_t bits16) { return __half2float(__ushort_as_half((unsigned short) (bits16 & 0xffffu))); }
+// an exact float of a small non-negative integer (q < 2^23) without the quarter-rate I2F: 2^23 + q, minus 2^23 + bias
+__device__ __forceinline__ float magic_minus(uint32_t q, float bias_plus_2p23) { return __int_as_float(0x4B000000u | q) - bias_plus_2p23; }
+__device__ __forceinline__ float warp_sum8_rows(const float (&a)[8], int lane) { return warp_sum8(a, lane); }   // sum of a[(lane >> 2) & 7]
+
+template <int FMT, int TT>
+__global__ void __launch_bounds__(256) down_kernel(GrMulti m, int t0, float* __restrict__ part) {
+    const int s = blockIdx.x, lane = threadIdx.x & 31, grp = blockIdx.y * 8 + (threadIdx.x >> 5);
+    if (grp >= GROUPS) return;
+    const bool inj = grp == LR / 8;
+    if (inj && m.a[0].nq_inject == nullptr) return;
+    float x[TT][8], sx[TT];
+#pragma unroll
+    for (int t = 0; t < TT; ++t) {
+        const float4* xp = reinterpret_cast<const float4*>(m.xn + (size_t) (t0 + t) * D + (size_t) s * 256 + lane * 8);
+        const float4 a = __ldg(xp), b = __ldg(xp + 1);
+        x[t][0] = a.x; x[t][1] = a.y; x[t][2] = a.z; x[t][3] = a.w; x[t][4] = b.x; x[t][5] = b.y; x[t][6] = b.z; x[t][7] = b.w;
+        sx[t] = ((a.x + a.y) + (a.z + a.w)) + ((b.x + b.y) + (b.z + b.w));
+    }
+    float p[8][TT];
+    if (FMT == 1 && !inj) {   // Q6_K: lane's 8 values: half n = lane >> 4, offset idx = (lane & 15) * 8 -> jl = idx >> 5, l0 = idx & 31
+        const int n = lane >> 4, idx = (lane & 15) * 8, jl = idx >> 5, l0 = idx & 31;
+        const int si = n * 8 + 2 * jl + (l0 >= 16 ? 1 : 0), s4 = 4 * (jl >> 1), s2 = 2 * jl;
+        uint2 ql[8], qh[8];
+        uint32_t scw[8];
+        float dd[8];
+#pragma unroll
+        for (int r = 0; r < 8; ++r) {
+            const uint8_t* blk = m.a[0].nq_down + ((size_t) (grp * 8 + r) * NS + s) * kHcNqQ6kBlock;
+            ql[r] = __ldg(reinterpret_cast<const uint2*>(blk + n * 64 + 32 * (jl & 1) + l0));
+            qh[r] = __ldg(reinterpret_cast<const uint2*>(blk + 128 + n * 32 + l0));
+            scw[r] = __ldg(reinterpret_cast<const uint32_t*>(blk + 192 + 4 * (si >> 2)));
+            dd[r] = __ldg(reinterpret_cast<const float*>(blk + 208));
+        }
+#pragma unroll
+        for (int r = 0; r < 8; ++r) {
+            const float a = dd[r] * (float) (int8_t) ((scw[r] >> (8 * (si & 3))) & 0xffu);   // ggml: d * sc, then * q
+            float q[8];
+#pragma unroll
+            for (int i = 0; i < 8; ++i) {
+                const uint32_t lw = i < 4 ? ql[r].x : ql[r].y, hw = i < 4 ? qh[r].x : qh[r].y;
+                q[i] = magic_minus(((lw >> (8 * (i & 3) + s4)) & 0xFu) | (((hw >> (8 * (i & 3) + s2)) & 3u) << 4), 8388640.0f);   // q - 32
+            }
+#pragma unroll
+            for (int t = 0; t < TT; ++t) {
+                float dq = q[0] * x[t][0];
+#pragma unroll
+                for (int i = 1; i < 8; ++i) dq = fmaf(q[i], x[t][i], dq);
+                p[r][t] = a * dq;
+            }
+        }
+    } else {                  // Q4_K (the down rows of fmt 0, and the inject rows)
+        const uint8_t* base = inj ? m.a[0].nq_inject : m.a[0].nq_down;
+        const int rbase = inj ? 0 : grp * 8, j = lane >> 2, sh = 4 * (j & 1);
+        uint4 hd[8];
+        uint2 qq[8];
+#pragma unroll
+        for (int r = 0; r < 8; ++r) {
+            const int rr = (!inj || r < HC) ? r : 0;
+            const uint8_t* blk = base + ((size_t) (rbase + rr) * NS + s) * kHcNqQ4kBlock;
+            hd[r] = __ldg(reinterpret_cast<const uint4*>(blk));
+            qq[r] = __ldg(reinterpret_cast<const uint2*>(blk + 16 + 32 * (j >> 1) + (lane & 3) * 8));
+        }
+#pragma unroll
+        for (int r = 0; r < 8; ++r) {
+            const uint32_t sw[3] = {hd[r].y, hd[r].z, hd[r].w};
+            auto byte = [&](int i) -> uint32_t { return (sw[i >> 2] >> (8 * (i & 3))) & 0xffu; };
+            uint32_t sc, mn;
+            if (j < 4) { sc = byte(j) & 63u; mn = byte(j + 4) & 63u; }

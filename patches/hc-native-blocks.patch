+bool hc_native_ready() { return hcnq::part_of_current() != nullptr; }
+void hc_native_repack_q6k(const uint8_t* src, uint8_t* dst, int64_t n_blocks) {
+    for (int64_t b = 0; b < n_blocks; ++b) {
+        const uint8_t* s = src + b * 210;
+        uint8_t* o = dst + b * kHcNqQ6kBlock;
+        std::memcpy(o, s, 208);
+        uint16_t h;
+        std::memcpy(&h, s + 208, 2);
+        const float d = __half2float(__ushort_as_half(h));
+        std::memcpy(o + 208, &d, 4);
+        std::memset(o + 212, 0, kHcNqQ6kBlock - 212);
+    }
+}
+void hc_native_repack_q5_0_rows(const uint8_t* src, uint8_t* dst, int64_t rows) {
+    for (int64_t r = 0; r < rows; ++r) {
+        uint8_t* o = dst + r * kHcNqQ5Row;
+        std::memset(o, 0, kHcNqQ5Row);
+        uint32_t lo32[32] = {0}, hi32[32] = {0};
+        for (int k = 0; k < 10; ++k) {
+            const uint8_t* b = src + (r * 10 + k) * 22;
+            uint16_t h;
+            std::memcpy(&h, b, 2);
+            const float d = __half2float(__ushort_as_half(h));
+            std::memcpy(o + 256 + 4 * k, &d, 4);
+            uint32_t qh;
+            std::memcpy(&qh, b + 2, 4);
+            for (int l = 0; l < 32; ++l) {   // ggml: value j (< 16) = qs[j] & 15 | bit j of qh; value j + 16 = qs[j] >> 4 | bit j + 16
+                const int j = l & 15;
+                const uint32_t q = (l < 16 ? (b[6 + j] & 0xFu) : (uint32_t) (b[6 + j] >> 4)) | (((qh >> l) & 1u) << 4);
+                if (k < 6) lo32[l] |= q << (5 * k);
+                else hi32[l] |= q << (5 * (k - 6));
+            }
+        }
+        for (int l = 0; l < 32; ++l) {
+            std::memcpy(o + 8 * l, &lo32[l], 4);
+            std::memcpy(o + 8 * l + 4, &hi32[l], 4);
+        }
+    }
+}

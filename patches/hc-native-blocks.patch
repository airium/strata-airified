+            const float a = h2f(hd[r].x) * (float) sc, b = h2f(hd[r].x >> 16) * (float) mn;   // ggml: d1 = d * sc, m1 = min * m
+            float q[8];
+#pragma unroll
+            for (int i = 0; i < 4; ++i) {
+                q[i] = magic_minus((qq[r].x >> (8 * i + sh)) & 0xFu, 8388608.0f);
+                q[4 + i] = magic_minus((qq[r].y >> (8 * i + sh)) & 0xFu, 8388608.0f);
+            }
+#pragma unroll
+            for (int t = 0; t < TT; ++t) {
+                float dq = q[0] * x[t][0];
+#pragma unroll
+                for (int i = 1; i < 8; ++i) dq = fmaf(q[i], x[t][i], dq);
+                p[r][t] = fmaf(a, dq, -b * sx[t]);
+            }
+        }
+    }
+#pragma unroll
+    for (int t = 0; t < TT; ++t) {
+        float v[8];
+#pragma unroll
+        for (int r = 0; r < 8; ++r) v[r] = p[r][t];
+        const float sum = warp_sum8_rows(v, lane);
+        const int row = grp * 8 + ((lane >> 2) & 7);
+        if ((lane & 3) == 0 && row < ROWS) part[((size_t) s * PART_T + t0 + t) * ROWS + row] = sum;
+    }

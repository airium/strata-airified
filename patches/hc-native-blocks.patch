+// the 40 partial sums of every (token, row) in a fixed order: lo = silu(sum / hc), inject_out = sum
+__global__ void __launch_bounds__(128) reduce_kernel(GrMulti m, const float* __restrict__ part) {
+    const int i = blockIdx.x * blockDim.x + threadIdx.x;
+    if (i >= m.T * ROWS) return;
+    const int t = i / ROWS, row = i - t * ROWS;
+    if (row >= LR && m.a[0].nq_inject == nullptr) return;
+    float v[NS];
+#pragma unroll
+    for (int k = 0; k < NS; ++k) v[k] = part[((size_t) k * PART_T + t) * ROWS + row];
+    float s = 0.0f;
+#pragma unroll
+    for (int k = 0; k < NS; ++k) s += v[k];
+    if (row < LR) {
+        const float x = s / (float) HC;
+        m.a[t].lo[row] = x / (1.0f + __expf(-x));
+    } else m.a[t].inject_out[row - LR] = s;
+}
+// Up: a warp = 8 rows (stream c = r >> 1, column d0 + (r & 1)), a block = 8 warps = 16 columns.  Row layout (320 B):
+// lane l's u32 pair at 8 l (5-bit codes of element l of blocks 0..5 | 6..9), the 10 f32 block scales at 256.
+template <int TT>
+__global__ void __launch_bounds__(256) up_kernel(GrMulti m, int t0) {
+    const int lane = threadIdx.x & 31, warp = threadIdx.x >> 5;
+    const int d0 = blockIdx.x * 16 + 2 * warp;
+    const uint8_t* W = m.a[0].nq_up;
+    uint2 code[8];
+#pragma unroll
+    for (int r = 0; r < 8; ++r)
+        code[r] = __ldg(reinterpret_cast<const uint2*>(W + (size_t) ((r >> 1) * N + d0 + (r & 1)) * kHcNqQ5Row) + lane);
+    float lo[TT][10];
+#pragma unroll
+    for (int t = 0; t < TT; ++t)
+#pragma unroll
+        for (int i = 0; i < 10; ++i) lo[t][i] = m.a[t0 + t].lo[32 * i + lane];
+    float p[8][TT];
+#pragma unroll
+    for (int r = 0; r < 8; ++r) {
+        const float4* sc4 = reinterpret_cast<const float4*>(W + (size_t) ((r >> 1) * N + d0 + (r & 1)) * kHcNqQ5Row + 256);
+        const float4 sA = __ldg(sc4), sB = __ldg(sc4 + 1);
+        const float2 sC = __ldg(reinterpret_cast<const float2*>(sc4 + 2));
+        const float d[10] = {sA.x, sA.y, sA.z, sA.w, sB.x, sB.y, sB.z, sB.w, sC.x, sC.y};
+        float dq[10];
+#pragma unroll
+        for (int i = 0; i < 10; ++i) {
+            const uint32_t w = i < 6 ? code[r].x : code[r].y, sh = 5 * (i < 6 ? i : i - 6);
+            dq[i] = d[i] * magic_minus((w >> sh) & 31u, 8388624.0f);   // ggml: (q - 16) * d
+        }
+#pragma unroll
+        for (int t = 0; t < TT; ++t) {
+            float acc = dq[0] * lo[t][0];
+#pragma unroll
+            for (int i = 1; i < 10; ++i) acc = fmaf(dq[i], lo[t][i], acc);
+            p[r][t] = acc;
+        }
+    }
+    const int rr = (lane >> 2) & 7, c = rr >> 1, dcol = d0 + (rr & 1), row = c * N + dcol;
+#pragma unroll
+    for (int t = 0; t < TT; ++t) {
+        float v[8];
+#pragma unroll
+        for (int r = 0; r < 8; ++r) v[r] = p[r][t];
+        const float dot = warp_sum8_rows(v, lane);
+        float g = 0.0f;
+        if ((lane & 3) == 0) {
+            const FusedGrArgs& a = m.a[t0 + t];
+            float rv = a.R[row];
+            if (a.apply) {
+                rv = fmaf(a.bo_prev[dcol], 2.0f * sigmoidf_(a.inj_prev[c] / (float) HC), rv);
+                a.R_out[row] = rv;
+            }
+            const float xx = rv * a.w_norm[row] * a.rs[c];
+            g = xx * sigmoidf_(dot);
+        }
+        const float g0 = __shfl_sync(0xffffffffu, g, (lane & 4)), g1 = __shfl_sync(0xffffffffu, g, (lane & 4) + 8),
+                    g2 = __shfl_sync(0xffffffffu, g, (lane & 4) + 16), g3 = __shfl_sync(0xffffffffu, g, (lane & 4) + 24);
+        if (lane == 0 || lane == 4) {
+            float sum = 0.0f;
+            sum += g0; sum += g1; sum += g2; sum += g3;
+            m.a[t0 + t].mixed[d0 + (lane >> 2)] = sum / (float) HC;
+        }
+    }
+}
+float* g_part[64] = {};   // per device: NS x PART_T x ROWS partial sums (made by fused_gr_check, before any capture)
+float* part_of_current() {
+    int dev = 0;
+    return cudaGetDevice(&dev) == cudaSuccess && dev >= 0 && dev < 64 ? g_part[dev] : nullptr;
+}
+void prepare_current() {
+    int dev = 0;
+    if (cudaGetDevice(&dev) != cudaSuccess || dev < 0 || dev >= 64 || g_part[dev] != nullptr) return;
+    void* p = nullptr;
+    if (cudaMalloc(&p, (size_t) NS * PART_T * ROWS * sizeof(float)) == cudaSuccess) g_part[dev] = (float*) p;
+    else cudaGetLastError();
+}
+template <int FMT>
+void launch_down(const GrMulti& m, int t0, int tt, float* part, cudaStream_t st) {
+    const dim3 grid(NS, (GROUPS + 7) / 8);
+    switch (tt) {

+        case 2: down_kernel<FMT, 2><<<grid, 256, 0, st>>>(m, t0, part); break;
+        case 3: down_kernel<FMT, 3><<<grid, 256, 0, st>>>(m, t0, part); break;
+        default: down_kernel<FMT, 4><<<grid, 256, 0, st>>>(m, t0, part); break;
+    }
+}
+void launch_up(const GrMulti& m, int t0, int tt, cudaStream_t st) {
+    switch (tt) {
+        case 1: up_kernel<1><<<N / 16, 256, 0, st>>>(m, t0); break;
+        case 2: up_kernel<2><<<N / 16, 256, 0, st>>>(m, t0); break;
+        case 3: up_kernel<3><<<N / 16, 256, 0, st>>>(m, t0); break;
+        default: up_kernel<4><<<N / 16, 256, 0, st>>>(m, t0); break;
+    }
+}
+// the read: norm, down (token groups of at most 4), the fixed-order reduction, up (token groups of at most 4)
+bool launch(const GrMulti& m, cudaStream_t st, unsigned long long* stamp_buf, int stamp_i0) {
+    float* part = part_of_current();
+    if (part == nullptr) return false;
+    const int T = m.T;
+    gr_norm_split_kernel<<<dim3(T, HC), THREADS, 0, st>>>(m);
+    if (stamp_buf) gpu_stamp(stamp_buf, stamp_i0, (void*) st);
+    for (int t0 = 0; t0 < T; t0 += 4) {
+        const int tt = T - t0 < 4 ? T - t0 : 4;
+        if (m.a[0].nq_down_fmt == 1) launch_down<1>(m, t0, tt, part, st);
+        else launch_down<0>(m, t0, tt, part, st);
+    }
+    reduce_kernel<<<(T * ROWS + 127) / 128, 128, 0, st>>>(m, part);
+    if (stamp_buf) gpu_stamp(stamp_buf, stamp_i0 + 1, (void*) st);
+    for (int t0 = 0; t0 < T; t0 += 4) launch_up(m, t0, T - t0 < 4 ? T - t0 : 4, st);
+    return true;
+}
